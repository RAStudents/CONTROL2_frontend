{
  // Версия контракта события.
  // Нужна для обратной совместимости при изменении структуры.
  // Тип: string.
  // Обязательно.
  "schema_version": "1.0",

  "event": {
    // Уникальный идентификатор события.
    // Генерируется на Edge и не меняется при повторной отправке.
    // Используется для идентификации события в CONTROL.
    // Тип: string (рекомендуется UUID/ULID).
    // Обязательно.
    "id": "01K6JQ8M7Y7Q2J8N4W5V3R6T9P",

    // Машинно-читаемый код события.
    // Например: sleeping, fall, intrusion, ppe_missing.
    // Это бизнес-смысл события, а не название класса нейросети.
    // Тип: string.
    // Обязательно.
    "code": "sleeping",

    // Время, когда событие произошло.
    // Это время Edge, а не время получения сервером.
    // Тип: ISO 8601 datetime в UTC.
    // Обязательно.
    "occurred_at": "2026-09-16T18:09:53.470249Z",

    // Время начала события.
    // Используется, если событие имеет длительность.
    // Для мгновенного события может быть null.
    // Тип: ISO 8601 datetime | null.
    "started_at": "2026-09-16T18:09:48.470249Z",

    // Время окончания события.
    // Для продолжающегося или мгновенного события может быть null.
    // Тип: ISO 8601 datetime | null.
    "ended_at": "2026-09-16T18:09:53.470249Z",

    // Длительность события в миллисекундах.
    // Удобна для аналитики и не требует вычисления по started_at/ended_at.
    // Не должна передаваться вместе с отрицательным или некорректным интервалом.
    // Тип: integer >= 0 | null.
    "duration_ms": 5000,

    // Ключ идемпотентности.
    // Позволяет CONTROL понять, что повторно отправленное событие
    // является тем же самым событием, а не новым.
    // Должен сохраняться неизменным при retry/outbox.
    // Тип: string.
    // Обязательно.
    "idempotency_key": "20260916T130953Z_sleeping_dd15f0db",

    // Последовательный номер события на конкретном Edge.
    // Может использоваться для обнаружения пропусков и восстановления порядка.
    // Не является глобальным ID.
    // Тип: integer >= 0 | null.
    "sequence": 18427
  },

  "device": {
    // Внутренний идентификатор устройства в Acmenra/CONTROL.
    // По нему CONTROL связывает событие с карточкой устройства.
    // Тип: string.
    // Обязательно после регистрации устройства.
    "id": "3605e486-6572-4dd3-8b37-e71c11780976",

    // Внешний идентификатор устройства, если он существует во внешней системе.
    // Например, серийный номер, ID заказчика или старый device_external_id.
    // Не используется вместо внутреннего id.
    // Тип: string | null.
    "external_id": null,

    // Имя устройства для диагностики.
    // Например hostname.
    // Не должно использоваться как идентификатор или ключ авторизации.
    // Тип: string | null.
    "hostname": "edge-device-01"
  },

  "binding": {
    // Идентификатор бизнес-привязки устройства.
    // Через binding CONTROL понимает, где/для чего работает устройство:
    // объект, зона, транспорт, линия, камера и т.п.
    // Тип: string | null.
    "id": "7b6f8d4a-9a2f-4c7b-8e21-6c5d9b4a1123"
  },

  "source": {
    // Идентификатор источника изображения.
    // Например camera-01.
    // Тип: string | null.
    "camera_id": "camera-01",

    // Человекочитаемая/машинная роль камеры.
    // Например front, rear, entrance, cabin.
    // Тип: string | null.
    "camera_role": "front",

    // Ширина исходного кадра в пикселях.
    // Нужна для интерпретации исходного изображения и диагностики.
    // Тип: integer > 0 | null.
    "frame_width": 1920,

    // Высота исходного кадра в пикселях.
    // Тип: integer > 0 | null.
    "frame_height": 1080,

    // FPS источника изображения.
    // Это фактический/известный FPS источника, а не обязательно FPS обработки.
    // Тип: number >= 0 | null.
    "fps": 30.0
  },

  "model": {
    // Имя модели/модельного артефакта.
    // Нужно для воспроизводимости результата.
    // Тип: string | null.
    "name": "sleeping-detector",

    // Версия модели.
    // Позволяет понять, какой именно model artifact сформировал событие.
    // Тип: string | null.
    "version": "1.4.2",

    // Версия конфигурации инференса.
    // Отдельно от версии весов модели.
    // Например thresholds, class mapping и прочие runtime-настройки.
    // Тип: string | null.
    "config_version": "3",

    // Runtime, на котором выполнялся инференс.
    // Например onnxruntime, tensorrt, openvino.
    // CONTROL не должен зависеть от конкретного backend.
    // Тип: string | null.
    "runtime": "onnxruntime",

    // Версия runtime.
    // Нужна для диагностики воспроизводимости.
    // Тип: string | null.
    "runtime_version": "1.22.0",

    // SHA-256 конкретного model artifact.
    // Позволяет однозначно установить, какой бинарный артефакт использовался.
    // Тип: string | null.
    "artifact_sha256": null
  },

  "inference": {
    // Тип CV-задачи.
    // Например detect, segment, obb, classify, track.
    // Должен быть независим от конкретного backend (YOLO/OpenVINO/TensorRT).
    // Тип: string.
    "task": "detect",

    // Порог, использованный при формировании результата.
    // Нужен для последующего анализа и воспроизводимости.
    // Тип: number 0..1 | null.
    "threshold": 0.5,

    // Полная задержка инференса.
    // Только время model inference, если Edge может его измерить.
    // Не следует путать с общей задержкой pipeline.
    // Тип: number >= 0, milliseconds | null.
    "latency_ms": 42.7,

    // Результаты распознавания.
    // Пустой массив означает: инференс выполнен, но объектов не найдено.
    // null не используется.
    // Тип: array.
    "detections": [
      {
        // ID объекта внутри трека, если tracking используется.
        // Для обычного detection без tracking — null.
        // Тип: string | integer | null.
        "id": null,

        "class": {
          // Числовой ID класса из model/config.
          // Тип: integer | null.
          "id": 0,

          // Машинное имя класса.
          // Тип: string.
          "name": "sleeping"
        },

        // Уверенность конкретного обнаружения.
        // Это confidence объекта, а не всего события.
        // Тип: number 0..1 | null.
        "confidence": 0.93,

        "geometry": {
          // Тип геометрии.
          // Должен соответствовать унифицированной геометрии acmenra-cv.
          // Например box, polygon, obb.
          // Тип: string.
          "type": "box",

          // Координаты нормализованы относительно изображения.
          // Конкретная структура зависит от geometry.type и контракта acmenra-cv.
          // Не следует придумывать отдельный формат геометрии для CONTROL.
          // Тип: array<number>.
          "coordinates": [
            0.321,
            0.184,
            0.547,
            0.812
          ]
        }
      }
    ]
  },

  "media": {
    // Ссылка на preview/thumbnail в media storage.
    // Это object key/media ID, а не base64 и не обязательный публичный URL.
    // Тип: string | null.
    "preview": "events/01K6JQ8M7Y7Q2J8N4W5V3R6T9P/preview.jpg",

    // Ссылка на видеоматериал события.
    // Может отсутствовать, если видео не записывалось.
    // Тип: string | null.
    "video": "events/01K6JQ8M7Y7Q2J8N4W5V3R6T9P/incident.mp4"
  },

  "device_snapshot": {
    // Время, к которому относится snapshot.
    // Может немного отличаться от occurred_at.
    // Тип: ISO 8601 datetime.
    // Если snapshot отсутствует целиком, весь объект может быть null.
    "captured_at": "2026-09-16T18:09:53.420000Z",

    "cpu": {
      // Текущая загрузка CPU.
      // Тип: number 0..100 | null.
      "usage_percent": 74.2,

      // Температура CPU.
      // Тип: number, degrees Celsius | null.
      "temperature_c": 61.4
    },

    "gpu": {
      // Текущая загрузка GPU.
      // Тип: number 0..100 | null.
      "usage_percent": 81.7,

      // Температура GPU.
      // Тип: number, degrees Celsius | null.
      "temperature_c": 67.1,

      // Использование видеопамяти.
      // Тип: number 0..100 | null.
      "memory_usage_percent": 63.4
    },

    "memory": {
      // Использование оперативной памяти.
      // Тип: number 0..100 | null.
      "usage_percent": 72.8,

      // Использованная RAM.
      // Тип: integer >= 0, MB | null.
      "used_mb": 5920,

      // Общий объём RAM.
      // Тип: integer > 0, MB | null.
      "total_mb": 8192
    },

    "storage": {
      // Использование диска.
      // Тип: number 0..100 | null.
      "usage_percent": 48.1
    },

    "network": {
      // Уровень сигнала, если применимо к конкретному сетевому интерфейсу.
      // Для Ethernet обычно null.
      // Тип: number, dBm | null.
      "rssi_dbm": -61,

      // Задержка до контрольной точки/сервера.
      // Не является latency инференса.
      // Тип: number >= 0, milliseconds | null.
      "latency_ms": 18.4
    }
  },

  "performance": {
    // Время получения кадра/начала capture pipeline до обработки.
    // Тип: number >= 0, milliseconds | null.
    "capture_latency_ms": 8.2,

    // Время preprocessing.
    // Тип: number >= 0, milliseconds | null.
    "preprocess_latency_ms": 4.7,

    // Время inference.
    // Тип: number >= 0, milliseconds | null.
    "inference_latency_ms": 42.7,

    // Время postprocessing.
    // Тип: number >= 0, milliseconds | null.
    "postprocess_latency_ms": 3.1,

    // Суммарное время pipeline.
    // Тип: number >= 0, milliseconds | null.
    "total_latency_ms": 58.7,

    // FPS, который реально поступал на pipeline.
    // Тип: number >= 0 | null.
    "fps_input": 30.0,

    // FPS, который реально обрабатывался.
    // Тип: number >= 0 | null.
    "fps_processed": 28.7
  },

  "payload": {
    // Дополнительные данные конкретного типа события.
    // Здесь разрешены только данные, которые не являются частью общего контракта.
    // Если поле становится общим для большинства событий — его следует
    // вынести в основной контракт.
    // Тип: object.
    "frames_count": 60
  },

  // Время получения события CONTROL.
  // Заполняется сервером CONTROL, а не Edge.
  // При отправке с Edge это поле должно отсутствовать либо быть null.
  // Тип: ISO 8601 datetime | null.
  "received_at": null
}

